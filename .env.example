# CivicLens Environment Configuration Example

# Provider Chain
PROVIDER_CHAIN=gemini,nvidia

# Google Gemini API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# NVIDIA Vision API
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_VISION_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# Server Port
PORT=3000
